Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/TF
      Enabled: true
      Name: TF
    - Class: rviz/Image
      Enabled: true
      Image Topic: /marker_detector/debug_image
      Name: Debug Image
      Queue Size: 1
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /visualization_marker
      Name: Markers
    - Class: rviz/Path
      Enabled: true
      Name: Trajectory Path
      Topic: /trajectory_tracker/trajectory_path
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0
      Name: Current View
      Pitch: 0.5
      Target Frame: base_link
      Yaw: 0.0
Window Geometry:
  Height: 800
  Width: 1200
