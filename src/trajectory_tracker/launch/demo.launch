<?xml version="1.0"?>
<launch>
    <!-- ============================================================
         TRAJECTORY TRACKER DEMO LAUNCH
         ============================================================
         Complete demo showing UR10 robot with workspace and trajectory.

         This launch file:
         1. Launches UR10 robot with gripper
         2. Starts trajectory tracker system
         3. Opens RViz with all visualizations
         4. Shows debug camera window

         Usage:
           roslaunch trajectory_tracker demo.launch

         Then calibrate workspace:
           rosservice call /trajectory_tracker/calibrate_workspace "{marker_ids: [3, 7, 17, 11]}"

         Then extract line:
           rosservice call /trajectory_tracker/extract_line
         ============================================================ -->

    <!-- Arguments -->
    <arg name="device_id" default="0" doc="Camera device ID"/>
    <arg name="show_camera_gui" default="true" doc="Show camera debug window"/>

    <!-- ============================================================
         1. UR10 Robot Bringup (without RViz)
         ============================================================ -->
    <!-- Robot description -->
    <arg name="robot_prefix" default="ursa_"/>
    <arg name="joint_limited" default="false"/>
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find tum_ics_ur10_description)/urdf/ur10_robot_ft_lacquey.urdf.xacro' prefix:=$(arg robot_prefix) limited:=$(arg joint_limited)" />

    <!-- Load park position -->
    <rosparam command="load" file="$(find tum_ics_ur10_description)/robots/$(arg robot_prefix)ur10_zeros.yaml"/>

    <!-- Joint and robot state publishers -->
    <node name="joint_state_publisher_ur10" pkg="joint_state_publisher" type="joint_state_publisher">
        <param name="use_gui" value="false"/>
        <rosparam param="source_list" subst_value="True">[$(arg robot_prefix)joint_states, $(arg robot_prefix)fingers_joint_states]</rosparam>
    </node>
    <node name="robot_state_publisher_ur10" pkg="robot_state_publisher" type="robot_state_publisher"/>

    <!-- ============================================================
         2. Trajectory Tracker System
         ============================================================ -->
    <!-- Load configuration -->
    <rosparam file="$(find trajectory_tracker)/config/tracker_config.yaml" command="load"/>

    <!-- Camera Node -->
    <node name="camera_node" pkg="trajectory_tracker" type="camera_node.py" output="screen">
        <param name="device_id" value="$(arg device_id)"/>
        <param name="show_gui" value="$(arg show_camera_gui)"/>
        <param name="calibration_file" value="$(find trajectory_tracker)/config/camera_calibration.yaml"/>
    </node>

    <!-- Workspace Detector Node (Marker Detection + Coordinate Transform) -->
    <node name="workspace_detector_node" pkg="trajectory_tracker" type="workspace_detector.py" output="screen">
        <param name="show_debug" value="true"/>
    </node>

    <!-- Trajectory Publisher Node -->
    <node name="trajectory_publisher_node" pkg="trajectory_tracker" type="trajectory_publisher_node.py" output="screen"/>

    <!-- Line Extractor Node -->
    <node name="line_extractor_node" pkg="trajectory_tracker" type="line_extractor_node.py" output="screen"/>

    <!-- ============================================================
         3. RViz Visualization
         ============================================================ -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find trajectory_tracker)/config/demo.rviz"
          required="false"/>

    <!-- ============================================================
         Instructions
         ============================================================ -->
    <node name="instructions" pkg="trajectory_tracker" type="print_instructions.py" output="screen"/>

</launch>
