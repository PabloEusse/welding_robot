<?xml version="1.0"?>
<launch>
    <!-- ============================================================
         TRAJECTORY TRACKER LAUNCH FILE
         ============================================================
         Vision-based trajectory tracking for UR10 welding robot.

         Usage:
           roslaunch trajectory_tracker trajectory_tracker.launch
           roslaunch trajectory_tracker trajectory_tracker.launch detection_mode:=color
           roslaunch trajectory_tracker trajectory_tracker.launch show_gui:=true
         ============================================================ -->

    <!-- Arguments -->
    <arg name="device_id" default="0" doc="Camera device ID (0 for /dev/video0)"/>
    <arg name="width" default="1280" doc="Camera image width"/>
    <arg name="height" default="720" doc="Camera image height"/>
    <arg name="fps" default="30" doc="Camera FPS"/>
    <arg name="show_gui" default="false" doc="Show debug windows"/>

    <!-- Load configuration -->
    <rosparam file="$(find trajectory_tracker)/config/tracker_config.yaml" command="load"/>

    <!-- ============================================================
         Camera Node
         ============================================================ -->
    <node name="camera_node" pkg="trajectory_tracker" type="camera_node.py" output="screen">
        <param name="device_id" value="$(arg device_id)"/>
        <param name="width" value="$(arg width)"/>
        <param name="height" value="$(arg height)"/>
        <param name="fps" value="$(arg fps)"/>
        <param name="show_gui" value="$(arg show_gui)"/>
        <param name="calibration_file" value="$(find trajectory_tracker)/config/camera_calibration.yaml"/>
    </node>

    <!-- ============================================================
         Workspace Detector Node (Marker Detection + Coordinate Transform)
         ============================================================ -->
    <node name="workspace_detector_node" pkg="trajectory_tracker" type="workspace_detector.py" output="screen">
        <param name="show_debug" value="true"/>
        <!-- ArUco and coordinate transform settings loaded from YAML -->
    </node>

    <!-- ============================================================
         Trajectory Publisher Node
         ============================================================ -->
    <node name="trajectory_publisher_node" pkg="trajectory_tracker" type="trajectory_publisher_node.py" output="screen"/>

    <!-- ============================================================
         Line Extractor Node
         ============================================================ -->
    <node name="line_extractor_node" pkg="trajectory_tracker" type="line_extractor_node.py" output="screen">
        <!-- Color detection settings loaded from YAML -->
    </node>

    <!-- ============================================================
         RViz for visualization (optional)
         ============================================================ -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find trajectory_tracker)/config/tracker.rviz"
          if="$(arg show_gui)"/>

</launch>
