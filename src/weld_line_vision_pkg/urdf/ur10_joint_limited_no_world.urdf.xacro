<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur10">
  <!-- UR10 model without world->base_link joint.
       base_link pose is provided by vision TF: workspace_frame -> base_link. -->
  <xacro:include filename="$(find tum_ics_ur10_description)/urdf/ur10.urdf.xacro" />
  <xacro:ur10_robot prefix="" joint_limited="true" />
</robot>
