<launch>
  <arg name="video_device" default="/dev/video0" />
  <arg name="image_width" default="640" />
  <arg name="image_height" default="480" />
  <arg name="pixel_format" default="yu12" />
  <arg name="framerate" default="30" />
  <arg name="io_method" default="read" />
  <arg name="rotate_image_90_cw" default="true" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_camera"
        args="0 0 0 0 0 0 world camera_optical_frame" />

  <node pkg="usb_cam" type="usb_cam_node" name="droidcam" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="io_method" value="$(arg io_method)"/>
    <param name="camera_frame_id" value="camera_optical_frame"/>
  </node>

  <node pkg="weld_line_vision" type="weld_line_vision_node" name="weld_line_vision" output="screen">
    <param name="image_topic" value="/droidcam/image_raw"/>
    <param name="info_topic" value="/droidcam/camera_info"/>
    <param name="frame_id" value="camera_optical_frame"/>
    <param name="rotate_image_90_cw" value="$(arg rotate_image_90_cw)"/>

    <param name="h_low" value="85"/>
    <param name="h_high" value="115"/>
    <param name="s_low" value="40"/>
    <param name="v_low" value="80"/>

    <param name="min_color_pixels" value="5"/>
    <param name="step_u" value="6"/>
  </node>
</launch>
