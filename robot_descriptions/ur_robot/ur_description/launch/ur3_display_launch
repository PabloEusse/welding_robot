<?xml version="1.0"?>
<launch>
  <!-- Load the robot description -->
  <include file="$(find ur_description)/launch/ur3_upload.launch" />

  <!-- Publish joint states using a GUI (you can move sliders) -->
  <!-- <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" /> -->

  <!-- Publish transforms between robot links -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  <!-- Publish joint states with GUI sliders -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ur_description)/cfg/view_robot.rviz" required="true" />
</launch>
